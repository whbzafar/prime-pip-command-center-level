    "User": {
      "title": "User",
      "description": "User profile with role-based permissions in the Prime PIP FX Command Center.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "role": {
          "type": "string",
          "enum": ["USER", "TRADER", "ANALYST", "ADMIN", "DEVELOPER"],
          "description": "Role determining access level"
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "SUSPENDED", "PENDING"],
          "description": "Account status"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role", "status", "createdAt", "updatedAt"]
    },
    "Asset": {
      "title": "Asset",
      "description": "Tradable instrument or asset across Forex, Commodities, Indices, Crypto, and Stocks.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Deterministic asset ID (e.g., asset_usd, asset_xau)" },
        "symbol": { "type": "string", "description": "Ticker symbol (e.g., USD, XAU, US30, BTCUSDT, NVDA)" },
        "name": { "type": "string", "description": "Full asset name" },
        "assetType": {
          "type": "string",
          "enum": ["CURRENCY", "COMMODITY", "INDEX", "CRYPTO", "STOCK"],
          "description": "Asset class category"
        },
        "currency": { "type": "string", "description": "Base or quote currency" },
        "country": { "type": "string", "description": "Jurisdiction or country code" },
        "exchange": { "type": "string", "description": "Primary exchange or reporting venue" },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "INACTIVE", "DELISTED"],
          "description": "Trading availability status"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "symbol", "name", "assetType", "status", "createdAt", "updatedAt"]
    },
    "Currency": {
      "title": "Currency",
      "description": "Sovereign currency definition with central bank and benchmark metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Currency ID (e.g., curr_usd)" },
        "code": { "type": "string", "description": "ISO 4217 Currency Code (e.g., USD, EUR)" },
        "name": { "type": "string", "description": "Currency name" },
        "country": { "type": "string", "description": "Issuing country or monetary union" },
