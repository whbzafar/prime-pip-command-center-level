{
  "modelVersion": "v0.1-initial",
  "description": "Pro Fundamentals Quantitative Macro Scoring Engine - Point-in-Time Audited",
  "calibrationScale": 1.0,
  "normalizationWindowYears": 8,
  "winsorizeLowerPercentile": 0.01,
  "winsorizeUpperPercentile": 0.99,
  "minObservations": 30,
  "jumpDownweightFactor": 0.5,
  "riskSigns": {
    "USD": 1.0,
    "JPY": 1.0,
    "CHF": 1.0,
    "EUR": -0.3,
    "GBP": -0.5,
    "CAD": -0.6,
    "AUD": -1.0,
    "NZD": -1.0
  },
  "freshnessTolerances": {
    "daily": { "freshDays": 3, "staleDays": 7 },
    "weekly": { "freshDays": 14, "staleDays": 28 },
    "monthly": { "freshDays": 45, "staleDays": 90 },
    "quarterly": { "freshDays": 120, "staleDays": 180 },
    "event": { "freshDays": 90, "staleDays": 180 }
  },
  "confidenceCoefficients": {
    "agreement": 0.40,
    "coverage": 0.25,
    "freshness": 0.20,
    "dispersion": 0.15
  },
  "confidenceThresholds": {
    "high": 0.75,
    "medium": 0.55
  },
  "sanityThresholds": {
    "vixStressPercentile": 0.90,
    "priceDivergenceAssetThreshold": 40.0,
    "priceDivergencePillarThreshold": 30.0,
    "crowdedPositioningHigh": 0.85,
    "crowdedPositioningLow": 0.15,
    "lowCoverageThreshold": 0.70,
    "minNonNullPillars": 4,
    "minConfiguredPillarWeightRatio": 0.60,
    "minPillarAvailableWeightRatio": 0.50
  },
  "monetaryDefaultWeights": {
    "DGS2": 0.35,
    "USD_2Y_MINUS_FEDFUNDS": 0.20,
    "DFII10": 0.20,
    "DFF": 0.15,
    "other": 0.10
  },
  "indicatorTransforms": {
