# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MYFXBOOK credentials: Optional live Forex and Commodities community outlook feeds
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=

# Live economic news provider endpoint.
# Must return a JSON array, or { "events": [...] } / { "items": [...] }.
# Do not use a source that violates its terms or rate limits.
ECONOMIC_NEWS_RADAR_URL=
