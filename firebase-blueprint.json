        "currency": { "type": "string", "description": "Associated currency code" },
        "country": { "type": "string", "description": "Country of release" },
        "description": { "type": "string", "description": "Methodology description" },
        "unit": { "type": "string", "description": "Measurement unit (e.g., %, Index, bps, USD)" },
        "frequency": {
          "type": "string",
          "enum": ["DAILY", "WEEKLY", "BIWEEKLY", "MONTHLY", "QUARTERLY", "SEMI_ANNUAL", "ANNUAL", "IRREGULAR"]
        },
        "sourceProvider": { "type": "string", "description": "Primary API provider code" },
        "sourceIdentifier": { "type": "string", "description": "Series identifier at the official source" },
        "sourceUrl": { "type": "string", "description": "Official reference URL" },
        "releaseSchedule": { "type": "string", "description": "Release timing description" },
        "importance": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "directionRule": { "type": "string", "enum": ["HIGHER_IS_BULLISH", "HIGHER_IS_BEARISH", "RANGE_BOUND"] },
        "status": { "type": "string", "enum": ["ACTIVE", "DEPRECATED", "INACTIVE"] },
