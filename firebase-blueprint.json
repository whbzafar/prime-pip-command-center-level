        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "currency", "country", "unit", "frequency", "importance", "directionRule", "status", "createdAt", "updatedAt"]
    },
    "DataSource": {
      "title": "DataSource",
      "description": "Authoritative statistical or governmental institution producing financial data.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Source identifier (e.g., src_fed, src_bls, src_ecb)" },
        "name": { "type": "string", "description": "Organization name" },
        "organization": { "type": "string", "description": "Parent institutional agency" },
        "country": { "type": "string", "description": "Country jurisdiction" },
        "sourceType": {
          "type": "string",
          "enum": [
            "CENTRAL_BANK",
            "STATISTICAL_AGENCY",
            "GOVERNMENT_TREASURY",
            "INTERNATIONAL_ORGANIZATION",
            "FINANCIAL_EXCHANGE",
            "COMMERCIAL_VENDOR"
          ]
        },
        "official": { "type": "boolean", "description": "Whether source is an official government agency" },
        "website": { "type": "string", "description": "Official institutional website" },
