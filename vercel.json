{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index?__route=/$1"
    },
    {
      "src": "/api",
      "dest": "/api/index?__route=/"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/index.html"
    }
  ]
}