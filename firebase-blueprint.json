        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "name", "country", "centralBank", "status", "createdAt", "updatedAt"]
    },
    "Indicator": {
      "title": "Indicator",
      "description": "Fundamental economic indicator registry definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Deterministic indicator ID (e.g., ind_us_cpi_yoy)" },
        "name": { "type": "string", "description": "Full formal indicator title" },
        "shortName": { "type": "string", "description": "Standard short code" },
        "category": {
          "type": "string",
          "enum": [
            "MONETARY_POLICY",
            "INFLATION",
            "GROWTH",
            "EMPLOYMENT",
            "WAGES",
            "INTEREST_RATES",
            "BOND_YIELDS",
            "TRADE",
            "CONSUMPTION",
            "BUSINESS_ACTIVITY",
            "HOUSING",
            "FISCAL",
            "COMMODITIES",
            "SENTIMENT",
            "POSITIONING"
          ]
        },
