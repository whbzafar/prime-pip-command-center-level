// ───────────────────────────── Candle history (index = bar index)
var array<float> O = array.new<float>()
var array<float> H = array.new<float>()
var array<float> L = array.new<float>()
var array<float> C = array.new<float>()
var array<int> T = array.new<int>()

// ───────────────────────────── Structure engine (bullish-normalised)
// dir = 1 reads candles as they are. dir = -1 mirrors them (prices negated), so one set of rules serves both sides.
type Eng
    int dir = 1
    int off = 0
    int anchor = 0
    float runHigh = na
    int hiIdx = 0
    int phase = 0
    bool pendOn = false
    int pS = 0
    float pMo = na
    float pMl = na
    float pLvl = na
    int pHi = 0
    float level = na
    int levelHi = 0
    int sIdx = 0
    int p2Idx = 0
    string kind = ""
    float mssLine = na
    int mssIdx = 0
    int mssCount = 0
    int mssFirst = 0
    int bosIdx = -1
    int lvlHiBos = 0
    float lvlBos = na
    bool z1Ok = false
    float z1Top = na
    float z1Bot = na
    int z1Left = 0
    bool z1Sbt2 = false
    bool z1Sbt3 = false
    bool z1Sbt5 = false
    int z1Sbt5Mid = -1
    int z1FvgMid = -1
    float z1FvgLo = na
    float z1FvgHi = na
    bool z2Ok = false
    float z2Top = na
    float z2Bot = na
    int z2Left = 0
    bool z2Mit = false
    bool z2Sbt4 = false
    int z2Sbt4Idx = -1
    float z2GapLo = na
    float z2GapHi = na
    bool evP2 = false
    bool evBos = false
    bool evMss = false
    float p2Low = na
    int p2LowIdx = 0
    int voidCnt = 0
    bool tzOk = false
    float tzTop = na
    float tzBot = na
    int tzIdx = 0
    int bosCnt = 0

method nO(Eng this, int i) =>
    this.dir * array.get(O, i)

method nC(Eng this, int i) =>
    this.dir * array.get(C, i)

method nH(Eng this, int i) =>
    this.dir == 1 ? array.get(H, i) : -array.get(L, i)

method nL(Eng this, int i) =>
    this.dir == 1 ? array.get(L, i) : -array.get(H, i)

method isBull(Eng this, int i) =>
    this.nC(i) > this.nO(i)

method isBear(Eng this, int i) =>
    this.nC(i) < this.nO(i)

method sz(Eng this, int k) =>
    useRange ? this.nH(k) - this.nL(k) : math.abs(this.nC(k) - this.nO(k))

method isLarge(Eng this, int j, int b) =>
    float mx = na
    for d = -2 to 2
        if d != 0
            int k = j + d
            if k >= this.off and k <= b
                float s = this.sz(k)
                mx := na(mx) ? s : math.max(mx, s)
    not na(mx) and this.sz(j) >= ratio * mx

// Zones, MSS line and structure data at the moment of a BOS
method doBos(Eng this, int b) =>
    float lv = this.level
    int s = this.sIdx
    // Level 1 zone: green candle with the highest close before the retracement, up to the BOS level
    int bestG = -1
    float bestGc = na
    for j = this.anchor to s - 1
        if this.isBull(j)
            float cj = this.nC(j)
            if na(bestGc) or cj > bestGc
                bestGc := cj
                bestG := j
    this.z1Ok := bestG >= 0
    if this.z1Ok
        this.z1Top := lv
        this.z1Bot := bestGc
        this.z1Left := bestG
        // SBT-2: a countertrend candle (red, in a bullish leg) somewhere in the impulse leg, before the BOS, that
        // overlaps the Level 1 zone at all. An ordinary candle must overlap by its BODY. A doji-type candle (its
        // wick is longer than its body) only needs its WICK (full high-to-low range) to reach into the zone.
        bool sbt2 = false
        float tol = (this.z1Top - this.z1Bot) * touchTol / 100.0
        // every countertrend candle from the structure start up to the candle before the BOS candle is checked
        if b - 1 >= this.anchor
            for j = this.anchor to b - 1
                if this.isBear(j)
                    float bLo = math.min(this.nO(j), this.nC(j))
                    float bHi = math.max(this.nO(j), this.nC(j))
                    float body = bHi - bLo
                    float rng = this.nH(j) - this.nL(j)
                    bool doji = (rng - body) > body
                    float lo = doji ? this.nL(j) : bLo
                    float hi = doji ? this.nH(j) : bHi
                    if hi >= this.z1Bot - tol and lo <= this.z1Top + tol
                        sbt2 := true
        this.z1Sbt2 := sbt2
        // SBT5: a countertrend candle (red in a bullish leg) whose BODY sits in the Level 1 zone (input: fully inside or any
        // overlap) with a bullish Fair Value Gap alongside it - the candle is candle 1 or candle 3 of the gap, or comes
        // immediately after the gap. Same candle without such a gap = plain SBT-2.
        bool sbt5 = false
        int sbt5Mid = -1
        if b - 1 >= this.anchor + 1
            for m = this.anchor + 1 to b - 1
                if not sbt5 and this.isBull(m) and this.nL(m + 1) > this.nH(m - 1)
                    // a bullish Fair Value Gap (candles m-1, m, m+1). The countertrend candle may be candle 1, candle 3,
                    // or the candle immediately after the gap (always before the BOS candle).
                    for q = 0 to 2
                        int r = q == 0 ? m - 1 : q == 1 ? m + 1 : m + 2
                        if not sbt5 and r >= this.anchor and r <= b - 1 and this.isBear(r)
                            float b5Lo = math.min(this.nO(r), this.nC(r))
                            float b5Hi = math.max(this.nO(r), this.nC(r))
                            bool in5 = sbt5Fit ? (b5Lo >= this.z1Bot - tol and b5Hi <= this.z1Top + tol) : (b5Hi >= this.z1Bot - tol and b5Lo <= this.z1Top + tol)
                            if in5
                                sbt5 := true
                                sbt5Mid := m
        this.z1Sbt5 := sbt5
        this.z1Sbt5Mid := sbt5Mid
        // SBT-3: a 3-candle Fair Value Gap where candle 3 can be anywhere UP TO AND INCLUDING the BOS candle itself
        // (the gap's 3rd candle is often the very candle that completes/confirms the break of structure), where
        // the middle candle is bullish (real green in a bullish leg, real red in a bearish leg - the mirroring
        // already handles this the same way the Level 1 zone's own forming candle does) and the gap (candle 1's
        // high .. candle 3's low) overlaps the Level 1 zone at all, even partially.
        bool sbt3 = false
        int fvgMid = -1
        float fvgLo = na
        float fvgHi = na
        for j = this.anchor + 1 to b - 1
            if j <= b - 1 and this.isBull(j)
                float gapLo = this.nH(j - 1)
                float gapHi = this.nL(j + 1)
                if gapHi > gapLo and gapHi >= this.z1Bot and gapLo <= this.z1Top
                    if fvgMid == -1
                        fvgMid := j
                        fvgLo := gapLo
                        fvgHi := gapHi
                    sbt3 := true
        this.z1Sbt3 := sbt3
        this.z1FvgMid := fvgMid
        this.z1FvgLo := fvgLo
        this.z1FvgHi := fvgHi
    // Level 2 zone: red candle with the lowest close between retracement start and BOS
    int bestR = -1
    float bestRc = na
    for j = this.levelHi to b - 1
        if this.isBear(j)
            float cj = this.nC(j)
            if na(bestRc) or cj < bestRc
                bestRc := cj
                bestR := j
    this.z2Ok := bestR >= 0
    if this.z2Ok
        float bodyR = math.abs(this.nC(bestR) - this.nO(bestR))
        bool dojiR = (this.nH(bestR) - this.nL(bestR) - bodyR) > bodyR
        // lowest low from the candle itself up to and including the BOS candle (never further back: that is the MSS line)
        float botRange = na
        for k = bestR to b
            float lk = this.nL(k)
            botRange := na(botRange) ? lk : math.min(botRange, lk)
        float top = na
        float bot = na
        if l2Mark == "Zone Marking On"
            // open down to the candle's own low; a doji is marked whole
            top := dojiR ? this.nH(bestR) : this.nO(bestR)
            bot := this.nL(bestR)
        else
            bot := botRange
            if dojiR
                // whole doji (high to low); if its wick reaches into Level 1: from its open down to the low
                bool wickInL1 = this.z1Ok and this.nH(bestR) >= this.z1Bot
                top := wickInL1 ? this.nO(bestR) : this.nH(bestR)
            else
                // ordinary, large or engulfing red candle: from its open down
                top := this.nO(bestR)
        this.z2Top := top
        this.z2Bot := bot
        this.z2Left := bestR
        // SBT-1 mitigation: a candle AFTER the zone candle but BEFORE the BOS candle already traded back into the zone
        // (its low reached the zone's top edge or deeper). If so the zone is "mitigated" -> COND, not a clean SBT-1.
        bool mit = false
        for k = bestR + 1 to b - 1
            bool leaves = k == bestR + 1 and this.isBull(k)   // the candle that simply moves away from the zone is not a re-test
            if k <= b - 1 and not leaves and this.nL(k) <= top
                mit := true
        this.z2Mit := mit
        // SBT 4: FVG right after Zone 2. Candle 1 (k-1) is the last candle still touching the zone, the middle candle
        // (k) is bullish, candle 3 (k+1, up to the BOS candle) opens the gap above candle 1's high.
        bool s4 = false
        int s4Idx = -1
        float s4Lo = na
        float s4Hi = na
        for k = bestR + 1 to b - 1
            if k <= b - 1 and not s4 and this.isBull(k)
                float g1 = this.nH(k - 1)
                float g3 = this.nL(k + 1)
                if g3 > g1 and this.nL(k - 1) <= top and g1 >= bot
                    s4 := true
                    s4Idx := k - 1
                    s4Lo := g1
                    s4Hi := g3
        this.z2Sbt4 := s4
        this.z2Sbt4Idx := s4Idx
        this.z2GapLo := s4Lo
        this.z2GapHi := s4Hi
    // MSS line: lowest low between 1 and the BOS
    float mss = na
    int m0 = this.z2Ok ? this.z2Left : this.levelHi + 1   // the lowest low from the Level 2 candle up to the BOS candle
    int mi = m0
    for k = m0 to b
        float lk = this.nL(k)
        if na(mss) or lk < mss
            mss := lk
            mi := k
    this.mssLine := mss
    this.mssIdx := mi
    this.mssCount := 0
    this.bosIdx := b
    this.lvlHiBos := this.levelHi
    this.lvlBos := lv
    this.anchor := b
    this.runHigh := this.nH(b)
    this.hiIdx := b
    this.phase := 0
    this.pendOn := false
    this.bosCnt := this.bosCnt + 1
    this.evBos := true

// One closed candle: MSS check, BOS check, retracement detection
method feed(Eng this, int i) =>
    this.evP2 := false
    this.evBos := false
    this.evMss := false
    float cl = this.nC(i)
    bool done = false
    if not na(this.mssLine)
        if cl < this.mssLine
            if this.mssCount == 0
                this.mssFirst := i
            this.mssCount := this.mssCount + 1
            if this.mssCount >= mssN
                this.evMss := true
                done := true
        else
            this.mssCount := 0
    if not done
        if this.phase == 1
            if cl > this.level
                this.doBos(i)
            else
                // a deeper retracement only moves point 2; the main structure is never discarded
                float lw = this.nL(i)
                if lw < this.p2Low
                    this.p2Low := lw
                    this.p2LowIdx := i
        else
            bool completed = false
            string kd = ""
            int s = 0
            float lvl = na
            int hi = 0
            bool hasPrev = i - 1 >= this.off
            if not this.pendOn
                if hasPrev and this.isBull(i - 1) and this.isBear(i)
                    if cl < this.nL(i - 1)
                        completed := true
                        kd := "engulfing"
                        s := i
                        lvl := this.runHigh
                        hi := this.hiIdx
                    else
                        this.pendOn := true
                        this.pS := i
                        this.pMo := this.nO(i)
                        this.pMl := this.nL(i)
                        this.pLvl := this.runHigh
                        this.pHi := this.hiIdx
            else
                if this.isBear(i) and cl < this.pMl
                    completed := true
                    kd := i == this.pS + 1 ? "two-candle" : "inside bar"
                    s := this.pS
                    lvl := this.pLvl
                    hi := this.pHi
                else if this.isBull(i) and cl > this.pMo
                    this.pendOn := false
            if completed
                // the high of the retracement's own first candle counts too (a spike that closes red)
                for k = s to i
                    if this.nH(k) > lvl
                        lvl := this.nH(k)
                        hi := k
                this.pendOn := false
                this.phase := 1
                this.level := lvl
                this.levelHi := hi
                this.sIdx := s
                this.p2Idx := i
                this.kind := kd
                float lowest = na
                int lowestIdx = i
                // the high can be the completing candle itself (hi == i); never loop backwards past the last candle
                if hi + 1 <= i
                    for k = hi + 1 to i
                        float lk = this.nL(k)
                        if na(lowest) or lk < lowest
                            lowest := lk
                            lowestIdx := k
                if na(lowest)
                    lowest := this.nL(i)
                this.p2Low := lowest
                this.p2LowIdx := lowestIdx
                this.voidCnt := 0
                this.evP2 := true
            else
                float h = this.nH(i)
                if na(this.runHigh) or h > this.runHigh
                    this.runHigh := h
                    this.hiIdx := i
    true

// Zone at the MSS: green candle with the highest close at the top, from its open up to the highest high
method topZone(Eng this, int i) =>
    int bj = -1
    float bc = na
    for j = this.bosIdx to i
        if this.isBull(j)
            float cj = this.nC(j)
            if na(bc) or cj > bc
                bc := cj
                bj := j
    float top = na
    float bot = na
    if bj >= 0
        float bodyBj = math.abs(this.nC(bj) - this.nO(bj))
        float rangeBj = this.nH(bj) - this.nL(bj)
        // wick longer than the body (doji / spinning top): mark the entire candle
        bot := (rangeBj - bodyBj) > bodyBj ? this.nL(bj) : this.nO(bj)
        top := this.nH(bj)
        for k = bj to i
            top := math.max(top, this.nH(k))
    this.tzOk := bj >= 0
    this.tzTop := top
    this.tzBot := bot
    this.tzIdx := bj
    true

// Double / triple MSS: the "far" zone. `this` is the engine of the trend that is being left (its frame is the mirror of the new trend).
// A countertrend candle of the NEW trend is a bullish candle in this engine's frame: the one with the highest close (lowest close in
// the new trend's frame) from the engine's start up to the start of its retracement. Zone = that candle's OPEN to the extreme
// (ownExt: the lowest / highest point reached up to the retracement; otherwise only the candle's own high / low). Prices are real.
type DmZ
    bool ok = false
    float fo = na
    float fc = na
    float ff = na
    int ix = -1

method dmF(Eng this, int s, bool ownExt) =>
    DmZ r = DmZ.new()
    int best = -1
    float bc = na
    if s >= this.off
        for j = this.off to s
            if this.isBull(j)
                float cj = this.nC(j)
                if na(bc) or cj > bc
                    bc := cj
                    best := j
    if best >= 0
        float far = this.nH(best)
        if ownExt
            for k = best to s
                far := math.max(far, this.nH(k))
        r.ok := true
        r.fo := this.dir * this.nO(best)
        r.fc := this.dir * bc
        r.ff := this.dir * far
        r.ix := best
    r

// ───────────────────────────── Drawing helpers
// right edge of a zone: the wanted time + the END shift, never left of the zone's start, never longer than the optional maximum
f_zr(box b, int x) =>
    int lf = box.get_left(b)
    int r = math.max(x + zShiftR * zBarMs, lf + zBarMs)
    if zMaxBars > 0
        r := math.min(r, lf + zMaxBars * zBarMs)
    r

f_zbox(int left, float p1, float p2, color col, string txt, bool dotted = false, int fillT = 82, int bw = 1) =>
    box bx = box.new(left + zShiftL * zBarMs, math.max(p1, p2), time, math.min(p1, p2), border_color = color.new(col, 40), border_width = bw, border_style = dotted ? line.style_dotted : line.style_solid, xloc = xloc.bar_time, extend = extend.none, bgcolor = color.new(col, fillT), text = txt, text_size = szZone, text_color = cZTxt, text_halign = text.align_center, text_valign = text.align_center)
    box.set_right(bx, f_zr(bx, time))
    bx

f_endbox(box b, int x) =>
    if not na(b)
        box.set_extend(b, extend.none)
        box.set_right(b, f_zr(b, x))
    true

// an open zone reaches only to the latest candle (never into the empty space on the right)
f_grow(box b, int x) =>
    if not na(b)
        box.set_extend(b, extend.none)
        box.set_right(b, f_zr(b, x))
    true

f_endline(line l, int x) =>
    if not na(l)
        line.set_extend(l, extend.none)
        line.set_x2(l, x)
    true

var bool followMain = false   // after a five-wave trend shift the new structure is followed with the normal 1, 2, 3 count
var bool markDir = false      // directional marks on (setting, or following a five-wave shift)
var bool fmark = false   // draw the 1 / 2 / BS marks of this structure even when directional marks are off (five-wave promotion)

// ───────────────────────────── Anti-directional marks (only drawn when the setting is on)
var array<label> antiL = array.new<label>()
var array<line> antiN = array.new<line>()

f_antiClear() =>
    for l in antiL
        label.delete(l)
    for n in antiN
        line.delete(n)
    array.clear(antiL)
    array.clear(antiN)
    true

// Anti-directional A-B-C. The marks always come in this order (antiL holds them: size 1 = A, 2 = A + B, 3 = A + B + C):
//   A = the first point: the top of the retracement against the trend. Marked as soon as that retracement is confirmed, with its level line.
//   B = marked ONLY when a candle closes beyond A (the BOS). Never before.
//   C = marked ONLY after B exists, when the pullback after B has formed.
f_antiA(Eng e) =>
    if array.size(antiL) == 0
        int dd = e.dir
        int hi = e.levelHi
        float lp = dd * e.level
        array.push(antiN, line.new(array.get(T, hi), lp, math.max(time, array.get(T, hi) + 1), lp, xloc = xloc.bar_time, color = cAnti, style = line.style_dashed, width = 1, extend = extend.right))
        array.push(antiL, label.new(array.get(T, hi), dd == 1 ? array.get(H, hi) : array.get(L, hi), "A", xloc = xloc.bar_time, style = dd == 1 ? label.style_label_down : label.style_label_up, color = cAnti, textcolor = cTxt, size = szAnti))
    true

// a candle closed beyond A: the level line ends here and B is marked on that candle
f_antiBos(Eng e) =>
    if array.size(antiL) == 0
        f_antiA(e)
    if array.size(antiL) == 1
        int dd = e.dir
        int bi = e.bosIdx
        float lp = dd * e.lvlBos
        if array.size(antiN) > 0
            line ln = array.get(antiN, 0)
            line.set_extend(ln, extend.none)
            line.set_x2(ln, array.get(T, bi))
        array.push(antiL, label.new(array.get(T, bi), dd == 1 ? array.get(H, bi) : array.get(L, bi), "B", xloc = xloc.bar_time, style = dd == 1 ? label.style_label_down : label.style_label_up, color = cAnti, textcolor = cTxt, size = szAnti))
    true

// the pullback after B: C is marked at its peak, and only if B exists
f_anti3(Eng e) =>
    if array.size(antiL) == 2
        int dd = e.dir
        int pk = e.levelHi
        array.push(antiL, label.new(array.get(T, pk), dd == 1 ? array.get(H, pk) : array.get(L, pk), "C", xloc = xloc.bar_time, style = dd == 1 ? label.style_label_down : label.style_label_up, color = cAnti, textcolor = cTxt, size = szAnti))
    true

// ───────────────────────────── Minor structure: swing pivots against the trend (zigzag A-B-C-D-E)
// Prices are stored in the counter-directional frame (bullish-normalised for that direction): element 0 = the trend's extreme (a low),
// then high, low, high, low, high ... Pivots need two candles on each side.
var array<int> mzI = array.new<int>()
var array<float> mzP = array.new<float>()
var int mzBelow = 0
var int mzMin = 0        // earliest candle a minor-structure pivot may sit on (the first candle of the confirmed retracement)
var int mzStage = 0

f_hn(int k, int dd) =>
    dd == 1 ? array.get(H, k) : -array.get(L, k)

f_ln(int k, int dd) =>
    dd == 1 ? array.get(L, k) : -array.get(H, k)

f_cn(int k, int dd) =>
    dd * array.get(C, k)

f_on(int k, int dd) =>
    dd * array.get(O, k)

f_mzPivot(int k, int dd, int hiIdx) =>
    int r = 0
    if k > hiIdx and k >= mzMin and k - 2 >= 0 and k + 2 < array.size(H)
        bool ph = f_hn(k, dd) > f_hn(k - 1, dd) and f_hn(k, dd) > f_hn(k - 2, dd) and f_hn(k, dd) >= f_hn(k + 1, dd) and f_hn(k, dd) >= f_hn(k + 2, dd)
        bool pl = f_ln(k, dd) < f_ln(k - 1, dd) and f_ln(k, dd) < f_ln(k - 2, dd) and f_ln(k, dd) <= f_ln(k + 1, dd) and f_ln(k, dd) <= f_ln(k + 2, dd)
        bool wantHigh = array.size(mzI) % 2 == 1
        r := ph and pl ? (wantHigh ? 1 : -1) : ph ? 1 : pl ? -1 : 0
    r

f_mzAdd(int k, int dd, bool isHigh) =>
    int n = array.size(mzI)
    bool wantHigh = n % 2 == 1
    float v = isHigh ? f_hn(k, dd) : f_ln(k, dd)
    if isHigh == wantHigh
        array.push(mzI, k)
        array.push(mzP, v)
    else if n > 1
        // same kind as the last pivot: keep the more extreme one (the trend's own extreme is never touched)
        int last = n - 1
        if (isHigh and v > array.get(mzP, last)) or (not isHigh and v < array.get(mzP, last))
            array.set(mzI, last, k)
            array.set(mzP, last, v)
    true

// a retracement has formed after candle k1: a candle (against the minor move) whose body closes below the previous candle's low
f_mzRetr(int k1, int last, int dd) =>
    bool ok = false
    if k1 + 1 <= last
        for j = k1 + 1 to last
            if not ok and j >= 1 and f_cn(j, dd) < f_on(j, dd) and f_cn(j, dd) < f_ln(j - 1, dd)
                ok := true
    ok

f_mzStart(int k, int dd) =>
    array.clear(mzI)
    array.clear(mzP)
    array.push(mzI, k)
    array.push(mzP, f_ln(k, dd))
    true

f_mzRebuild(int dd, int hiIdx, int last) =>
    f_mzStart(hiIdx, dd)
    if last - 2 >= hiIdx + 1
        for k = hiIdx + 1 to last - 2
            int pv = f_mzPivot(k, dd, hiIdx)
            if pv != 0
                f_mzAdd(k, dd, pv == 1)
    true

f_mzUpdate(int dd, int i, int hiIdx) =>
    if array.size(mzI) > 0
        int pv = f_mzPivot(i - 2, dd, hiIdx)
        if pv != 0
            f_mzAdd(i - 2, dd, pv == 1)
    true

var bool nextC = false   // after a five-wave shift: the first pending point is marked "C" and turns into "1" when it is broken
var int shFifthBar = -1

// ───────────────────────────── Pending structure visuals: 1 (or 3-1), 2 and the BS line
type Vis
    label l1 = na
    label l2 = na
    line bs = na
    bool on = false

method wipe(Vis this) =>
    if not na(this.l1)
        label.delete(this.l1)
    if not na(this.l2)
        label.delete(this.l2)
    if not na(this.bs)
        line.delete(this.bs)
    this.l1 := na
    this.l2 := na
    this.bs := na
    this.on := false
    true

// a retracement is confirmed: mark 1 (or 3-1) at the high, 2 at the lowest low, and put the BS line at the high's level
method showPending(Vis this, Eng e) =>
    this.wipe()
    int dd = e.dir
    int hi = e.levelHi
    int lo = e.p2LowIdx
    if showLbl
        this.l1 := label.new(array.get(T, hi), dd == 1 ? array.get(H, hi) : array.get(L, hi), e.bosIdx >= 0 ? (nextC ? "C" : "3") : "1", xloc = xloc.bar_time, style = dd == 1 ? label.style_label_down : label.style_label_up, color = e.bosIdx >= 0 ? c3 : c1, textcolor = cTxt, size = e.bosIdx >= 0 ? s3 : s1)
    this.bs := line.new(array.get(T, hi), dd * e.level, math.max(time, array.get(T, hi) + 1), dd * e.level, xloc = xloc.bar_time, color = cBos, style = line.style_dashed, width = 1, extend = extend.right)
    this.on := true
    true

// point 2 follows the lowest low until the break
method track(Vis this, Eng e) =>
    if e.phase == 1 and not na(this.l2)
        int lo = e.p2LowIdx
        label.set_xy(this.l2, array.get(T, lo), e.dir == 1 ? array.get(L, lo) : array.get(H, lo))
    true

// a candle body closed beyond the level: the BS line ends on that candle
method finish(Vis this, Eng e) =>
    int dd = e.dir
    int bi = e.bosIdx
    if this.on and not na(this.bs)
        line.set_extend(this.bs, extend.none)
        line.set_x2(this.bs, array.get(T, bi))
        if not na(this.l1)
            label.set_text(this.l1, "1")
            label.set_color(this.l1, c1)
            label.set_size(this.l1, s1)
    else if markDir or fmark
        float lp = dd * e.lvlBos
        line.new(array.get(T, e.lvlHiBos), lp, array.get(T, bi), lp, xloc = xloc.bar_time, color = cBos, style = line.style_dashed, width = 1)
        if showLbl
            label.new(array.get(T, e.lvlHiBos), dd == 1 ? array.get(H, e.lvlHiBos) : array.get(L, e.lvlHiBos), (nextC and e.bosIdx > shFifthBar) ? "C / 1" : "1", xloc = xloc.bar_time, style = dd == 1 ? label.style_label_down : label.style_label_up, color = c1, textcolor = cTxt, size = s1)
    if showLbl and (markDir or fmark)
        // the BS label sits inside the Level 1 zone (between the BS line and the highest green close)
        float lblY = e.z1Ok ? dd * (e.z1Top + e.z1Bot) / 2 : dd * e.lvlBos
        int lblX = e.z1Ok ? int((array.get(T, e.z1Left) + array.get(T, bi)) / 2) : array.get(T, bi)
        label.new(lblX, lblY, "BOS", xloc = xloc.bar_time, style = label.style_label_center, color = cBos, textcolor = cTxt, size = szBos)
        // point 2: the low (high) where the MSS line starts
        label.new(array.get(T, e.mssIdx), dd == 1 ? array.get(L, e.mssIdx) : array.get(H, e.mssIdx), "2", xloc = xloc.bar_time, style = dd == 1 ? label.style_label_up : label.style_label_down, color = c2, textcolor = cTxt, size = s2)
    if showLbl and showMssL
        // small tag where the MSS line starts (the lowest low between 1 and the BOS)
        label.new(array.get(T, e.mssIdx) + timeframe.in_seconds() * 1000, dd * e.mssLine, "MSS line", xloc = xloc.bar_time, style = label.style_text_outline, color = chart.bg_color, textcolor = cMssTag, size = szMssTag)
    this.l1 := na
    this.l2 := na
    this.bs := na
    this.on := false
    true

// the structure is abandoned (MSS, five-wave shift, trend back): stop the BS line here, keep the 3 label
method seal(Vis this) =>
    if this.on
        if not na(this.bs)
            line.set_extend(this.bs, extend.none)
            line.set_x2(this.bs, time)
        if not na(this.l1)
            if label.get_text(this.l1) == "3-1"
                label.set_text(this.l1, "3")
                label.set_color(this.l1, c3)
                label.set_size(this.l1, s3)
    this.l1 := na
    this.l2 := na
    this.bs := na
    this.on := false
    true

// ───────────────────────────── State
var Vis vis = Vis.new()
var bool ntOn = false     // new trend after an MSS: its 1-2 (entry) stays hidden until five waves are complete
var bool ntBos = false    // first break of the new trend seen
var bool ntRet = false    // retracement after that break seen (waves 3 and 4)
var float ntBody = na     // body of wave 3
var bool ntSeen = false   // a trend shift (MSS / trend back) has happened at least once
var int trend = 0
var Eng engB = na
var Eng engS = na
var Eng eng = na
var Eng sh = na
var int shHiIdx = -1
var int shStart = -1      // first candle of the confirmed retracement the anti-directional engine runs from (-1 = no retracement yet)
var float mzBrk = na      // minor structure: level of A (break = body close beyond it), counter-directional frame
var float mzShf = na      // minor structure: body top of the break candle (a body close beyond it shifts the trend)
var int shiftCutT = na    // start (time) of the structure that the last trend shift put an end to
var bool shFifth = false   // wave 5 has just been placed (shown in the table until a new anti-directional sequence starts)
// shFifthBar is declared above the Vis type
var bool shA3 = false
var bool shA4 = false
var float shA3c = na
var int shA3i = -1
var int shAi = -1          // candle of A (the level that B breaks)
var int shBi = -1          // candle of the first close beyond A (the break)
var int shBz = -1          // candle of the B zone (Level 2 zone created by that break)
var float shBzY = na       // real price of the B zone's outer edge
var float shBzT = na       // real price of the B zone's open edge
var float shApx = na       // prices of the last completed anti-directional A / B zone / C (status box)
var float shCpx = na
var float shBpxY = na
var float shBpxT = na
var int shCi = -1          // candle of C (the extreme after B)
var label lblC = na        // chart label of C, becomes "1" once the fifth leg forms
var label lblD = na        // chart label of D, becomes "2" once the fifth leg forms
var bool relabel = false

var box z1Box = na
var box z2Box = na
var bool z1Act = false
var bool z2Act = false
var int   pfB    = -1      // BOS bar whose zones still wait for the next candle (gap whose middle candle is the BOS candle)
var int   pfDir  = 0
var bool  pf3    = false   // SBT3 still to be checked on Level 1
var bool  pf4    = false   // SBT 4 still to be checked on Level 2
var float pfTop  = na
var float pfBot  = na
var bool  pfSbt2 = false
var bool  pfSbt5 = false
var box   pfBox  = na
var float pf2Top = na
var float pf2Bot = na
var int   pf2Left = 0
var box   pf2Box = na
var line mssLn = na
var array<box> lvBoxes = array.new<box>()

// double / triple MSS state. N = near zone (above price in a bullish trend), F = far zone. Prices real unless noted.
var bool dmOn = false
var int dmK = 0              // which MSS of the chain is active (2 = double, 3 = triple ...)
var int dmOd = 0             // direction of the trend before the first MSS (double MSS returns to it)
var int dmDir = 0            // trend direction after the latest flip
var float oldTzTop = na       // Double Top / Bottom candle zone saved at the first MSS (real prices)
var float oldTzBot = na
var int oldTzIdx = -1
var float dmNEdge = na       // near zone's edge toward the trend's start (new trend's frame)
var float dmPeak = na        // near zone's outer edge (new trend's frame); grows until the first retracement
var bool dmNFrz = true
var bool dmNAct = false
var float dmFo = na          // far zone: candle open, candle close, far extreme (real)
var float dmFc = na
var float dmFf = na
var int dmFi = -1
var int dmCnt = 0
var int dmFirst = 0
var box dmNBox = na
var box dmFBox = na
var bool dmBoxEnd = false    // the double-MSS boxes have been closed at the new trend's first retracement

var bool oldOn = false
var float oldLine = na
var int oldDir = 0
var int oldCnt = 0
var int oldFirst = 0

// ───────────────────────────── Main (confirmed bars only)
if barstate.isconfirmed
    markDir := showMain or followMain
    array.push(O, open)
    array.push(H, high)
    array.push(L, low)
    array.push(C, close)
    array.push(T, time)
    int i = array.size(C) - 1
    Eng drawE = na
    bool doDraw = false
    bool forceDraw = false

    if na(engB)
        engB := Eng.new(dir = 1, off = i, anchor = i, hiIdx = i)
        engS := Eng.new(dir = -1, off = i, anchor = i, hiIdx = i)

    if trend == 0
        // the first BOS in either direction decides the trend
        engB.feed(i)
        engS.feed(i)
        if engB.evBos
            eng := engB
            trend := 1
        else if engS.evBos
            eng := engS
            trend := -1
        if trend != 0
            drawE := eng
            doDraw := true
            shHiIdx := eng.hiIdx
            sh := Eng.new(dir = -eng.dir, off = eng.hiIdx, anchor = eng.hiIdx, hiIdx = eng.hiIdx)
            shStart := -1
            shA3 := false
            shA4 := false
    else
        int d = eng.dir
        eng.feed(i)
        // new trend after an MSS: waves 1-2, break, retracement (3-4), break beyond the 3 (5)
        if ntOn
            if eng.evBos
                if ntBos and ntRet
                    ntOn := false
                ntBos := true
                ntRet := false
                ntBody := na
            else if ntBos
                if eng.evP2
                    ntRet := true
                    int pk3 = eng.levelHi
                    ntBody := math.max(eng.nO(pk3), eng.nC(pk3))
                if ntRet and eng.nC(i) > ntBody
                    ntOn := false
        if eng.evP2 and markDir and not (ntOn and hideNt)
            vis.showPending(eng)
        if shFifth and i > shFifthBar and (shA3 or (not na(sh) and sh.phase == 1))
            shFifth := false
        bool shifted = false
        bool fifth = false
        bool invalid = false

        // Anti-directional (shadow) engine: starts at the latest extreme of the main engine
        // It only runs once a proper retracement of the trend is confirmed (main engine phase 1); it starts at that retracement's first candle.
        // The anti-directional structure is tracked from the moment a retracement BEGINS: either a confirmed retracement (phase 1) or a
        // retracement that is still pending, i.e. a valid inside bar (a red candle after a green one that has neither been closed below
        // nor cancelled by a close back above its open). A counter-trend sequence inside that inside bar therefore counts as a structural
        // event, and two anti-directional breaks inside it (B, then a body close beyond C) shift the trend, without waiting for the full retracement.
        int wantStart = (eng.phase == 1 and (eng.bosCnt >= 1 or ntOn or oldOn or dmOn or not needRetr)) ? eng.sIdx : (not needRetr and eng.pendOn) ? eng.pS : -1
        bool reset = na(sh) or eng.hiIdx != shHiIdx or wantStart != shStart
        if reset
            f_antiClear()
            shAi := -1
            shBi := -1
            shCi := -1
            shHiIdx := eng.hiIdx
            shStart := wantStart
            int st = wantStart >= 0 ? wantStart : eng.hiIdx
            // the retracement (counter-move) must be confirmed first; it then acts as the anti-directional impulse, so the anti engine
            // starts at the confirming candle. The impulse's high already reached (from the retracement's first candle) is kept.
            int fs = (wantStart >= 0 and needRetr and eng.phase == 1) ? math.max(st, eng.p2Idx) : st
            float fsHi = na
            int fsHiI = fs
            if fs > st
                for k = st to fs
                    float hk = f_hn(k, -d)
                    if na(fsHi) or hk > fsHi
                        fsHi := hk
                        fsHiI := k
            sh := Eng.new(dir = -d, off = fs, anchor = fs, runHigh = fsHi, hiIdx = fsHiI)
            shA3 := false
            shA4 := false
            if wantStart >= 0
                for k = fs to i
                    sh.feed(k)
                    if sh.evBos
                        if not shA3
                            shAi := sh.lvlHiBos
                            shBi := sh.bosIdx
                            shBz := sh.z2Ok ? sh.z2Left : sh.bosIdx
                            shBzY := sh.z2Ok ? sh.dir * sh.z2Bot : na
                            shBzT := sh.z2Ok ? sh.dir * sh.z2Top : na
                            shCi := -1
                        shA3 := true
                        shA4 := false
                        shA3c := na
                    else if shA3 and sh.evP2
                        shA4 := true
                        shCi := sh.levelHi
                        shA3c := sh.level   // the C level: its extreme (low / high), not the candle body
        else if shStart >= 0
            sh.feed(i)
            if sh.evBos
                if shA3
                    fifth := true // a second anti-directional 1-2-3 in succession
                else
                    shAi := sh.lvlHiBos
                    shBi := sh.bosIdx
                    shBz := sh.z2Ok ? sh.z2Left : sh.bosIdx
                    shBzY := sh.z2Ok ? sh.dir * sh.z2Bot : na
                    shBzT := sh.z2Ok ? sh.dir * sh.z2Top : na
                    shCi := -1
                shA3 := true // the break happened; wave 3 (the peak) is fixed by the next retracement
                shA3c := na
                shA3i := i
                shA4 := false
            else if shA3
                if sh.evP2
                    // retracement after the break: wave 3 (the peak) and wave 4 are established
                    shA4 := true
                    shCi := sh.levelHi
                    shA3c := sh.level   // the C level: its extreme (low / high), not the candle body
                if shA4 and sh.nC(i) > shA3c
                    fifth := true // close beyond the body of the 3 after the 4
                bool big = false
                if not na(sh.mssLine) and i >= 2
                    big := sh.nC(i) < sh.mssLine and sh.sz(i) >= ratio * math.max(sh.sz(i - 1), sh.sz(i - 2))
                if sh.evMss or big
                    invalid := true // two closes (or one large candle) beyond point 2

        // Minor structure: the same A-B-C read from swing pivots inside the retracement
        int sdir = -d
        mzMin := shStart >= 0 ? ((needRetr and eng.phase == 1) ? math.max(shStart, eng.p2Idx) : shStart) : 0
        if reset
            f_mzRebuild(sdir, eng.hiIdx, i)
            mzBelow := 0
        else
            f_mzUpdate(sdir, i, eng.hiIdx)
        mzStage := 0
        mzBrk := na
        mzShf := na
        bool mzFifth = false
        int mzA = -1
        int mzB = -1
        int mzC = -1
        int mzD = -1
        int mzBz = -1
        float mzBzY = na
        float mzBzT = na
        int mn = array.size(mzP)
        bool aOk = shStart >= 0 and mn >= 2
        if aOk and needRetr
            aOk := f_mzRetr(array.get(mzI, 1), i, sdir)   // A counts only once a retracement has formed after it
        if aOk
            mzStage := 1
            mzBrk := array.get(mzP, 1)
            int jb = -1
            if mn >= 4
                for j = 3 to mn - 1 by 2
                    if jb < 0 and array.get(mzP, j) > array.get(mzP, 1)
                        bool bodyUp = false
                        for q = array.get(mzI, 1) + 1 to array.get(mzI, j)
                            if f_cn(q, sdir) > array.get(mzP, 1)
                                bodyUp := true
                        if bodyUp
                            jb := j
            if jb > 0
                mzStage := 2
                int pj = array.get(mzI, jb)
                mzShf := f_hn(pj, sdir)   // the C level: the extreme of the C swing
                if mn > jb + 1 and (not needRetr or f_mzRetr(array.get(mzI, jb), i, sdir))   // C counts only once a retracement has formed after it
                    mzStage := 3
                    if f_cn(i, sdir) > mzShf and i > array.get(mzI, jb + 1)
                        mzFifth := true
                        mzA := array.get(mzI, 1)
                        mzC := array.get(mzI, jb)
                        mzD := array.get(mzI, jb + 1)
                        for q = mzA + 1 to mzC
                            if mzB < 0 and f_cn(q, sdir) > array.get(mzP, 1)
                                mzB := q
                        // B = the Level 2 zone made by that break: the countertrend candle with the lowest close between A and the break
                        if mzB > mzA
                            float bestc = na
                            for q = mzA to mzB - 1
                                if f_cn(q, sdir) < f_on(q, sdir)
                                    if na(bestc) or f_cn(q, sdir) < bestc
                                        bestc := f_cn(q, sdir)
                                        mzBz := q
                            if mzBz >= 0
                                float zLow = na
                                for q = mzBz to mzB
                                    zLow := na(zLow) ? f_ln(q, sdir) : math.min(zLow, f_ln(q, sdir))
                                float bodyZ = math.abs(f_cn(mzBz, sdir) - f_on(mzBz, sdir))
                                bool dojiZ = (f_hn(mzBz, sdir) - f_ln(mzBz, sdir) - bodyZ) > bodyZ
                                // same two states as the Level 2 zone: ON = the candle's own low, OFF = the lowest low up to the break
                                mzBzY := sdir * (l2Mark == "Zone Marking On" ? f_ln(mzBz, sdir) : zLow)
                                mzBzT := sdir * (dojiZ ? f_hn(mzBz, sdir) : f_on(mzBz, sdir))
            if mn >= 3 and not mzFifth
                // invalidation: two closes (or one large candle) beyond the low of leg 2
                float p2 = array.get(mzP, 2)
                bool below = f_cn(i, sdir) < p2
                mzBelow := below ? mzBelow + 1 : 0
                bool bigBelow = below and i >= 2 and math.abs(array.get(C, i) - array.get(O, i)) >= ratio * math.max(math.abs(array.get(C, i - 1) - array.get(O, i - 1)), math.abs(array.get(C, i - 2) - array.get(O, i - 2)))
                if mzBelow >= mssN or bigBelow
                    f_mzStart(i, sdir)
                    mzBelow := 0
                    mzStage := 0
        int mkA = -1
        int mkB = -1
        int mkC = -1
        int mkD = -1
        int mkBz = -1
        float mkBy = na
        float mkBt = na
        if fifth
            mkA := shAi
            mkB := shBi
            mkBz := shBz
            mkBy := shBzY
            mkBt := shBzT
            mkC := shCi
            mkD := sh.p2LowIdx
        if mzFifth and not fifth
            mkA := mzA
            mkB := mzB
            mkBz := mzBz
            mkBy := mzBzY
            mkBt := mzBzT
            mkC := mzC
            mkD := mzD
            sh := Eng.new(dir = sdir, off = eng.hiIdx, anchor = eng.hiIdx, hiIdx = eng.hiIdx)
            for k = eng.hiIdx to i
                sh.feed(k)
            fifth := true

        if fifth
            f_antiClear()
            followMain := true   // follow the new structure with the normal count from here
            array.clear(mzI)
            array.clear(mzP)
            mzStage := 0
            shFifth := true
            shFifthBar := i
            vis.seal()
            // five-wave shift: the anti-directional structure becomes the main one, two levels
            f_endline(mssLn, time)
            f_endbox(z1Box, time)
            f_endbox(z2Box, time)
            for b in lvBoxes
                f_endbox(b, time)
            array.clear(lvBoxes)
            z1Act := false
            z2Act := false
            oldOn := false
            if dmOn
                dmOn := false
                f_endbox(dmNBox, time)
                f_endbox(dmFBox, time)
            if eng.bosCnt > 0
                int cF = eng.lvlHiBos
                if eng.z1Ok
                    cF := math.min(cF, eng.z1Left)
                if eng.z2Ok
                    cF := math.min(cF, eng.z2Left)
                shiftCutT := array.get(T, cF)
            eng := sh
            trend := eng.dir
            ntOn := false
            drawE := eng
            doDraw := eng.bosCnt > 0
            forceDraw := true
            label.new(time, trend == 1 ? low : high, "5th wave: trend shift", xloc = xloc.bar_time, style = trend == 1 ? label.style_label_up : label.style_label_down, color = cMss, textcolor = cTxt, size = szFifth)
            // the trend has shifted (a body closed beyond C): only now are the anti-directional legs marked on the chart: A, B, C, D
            // (E, the fifth leg, is the break itself). As the fifth leg forms, C is re-labelled 1 and the C-D segment 2 (see below).
            lblC := na
            lblD := na
            shApx := mkA >= 0 ? ((-d) == 1 ? array.get(H, mkA) : array.get(L, mkA)) : na
            shCpx := mkC >= 0 ? ((-d) == 1 ? array.get(H, mkC) : array.get(L, mkC)) : na
            shBpxY := mkBy
            shBpxT := mkBt
            if showAnti and mkA >= 0 and mkB >= 0 and mkC >= 0
                int sd = -d
                label.new(array.get(T, mkA), sd == 1 ? array.get(H, mkA) : array.get(L, mkA), "A", xloc = xloc.bar_time, style = sd == 1 ? label.style_label_down : label.style_label_up, color = cAnti, textcolor = cTxt, size = szAnti)
                int bz = mkBz >= 0 ? mkBz : mkB
                float bY = na(mkBy) ? (sd == 1 ? array.get(L, bz) : array.get(H, bz)) : mkBy
                label.new(array.get(T, bz), bY, "B", xloc = xloc.bar_time, style = sd == 1 ? label.style_label_up : label.style_label_down, color = cAnti, textcolor = cTxt, size = szAnti)
                if not na(mkBy) and not na(mkBt)
                    box.new(array.get(T, bz), math.max(mkBy, mkBt), time, math.min(mkBy, mkBt), xloc = xloc.bar_time, border_color = cAnti, bgcolor = color.new(cAnti, 85), border_width = 1)
                lblC := label.new(array.get(T, mkC), sd == 1 ? array.get(H, mkC) : array.get(L, mkC), "C", xloc = xloc.bar_time, style = sd == 1 ? label.style_label_down : label.style_label_up, color = cAnti, textcolor = cTxt, size = szAnti)
                if mkD >= 0
                    lblD := label.new(array.get(T, mkD), sd == 1 ? array.get(L, mkD) : array.get(H, mkD), "D", xloc = xloc.bar_time, style = sd == 1 ? label.style_label_up : label.style_label_down, color = cAnti, textcolor = cTxt, size = szAnti)
                relabel := true
            shHiIdx := eng.hiIdx
            sh := Eng.new(dir = -eng.dir, off = eng.hiIdx, anchor = eng.hiIdx, hiIdx = eng.hiIdx)
            shStart := -1
            shA3 := false
            shA4 := false
        else
            if invalid
                f_antiClear()
                shAi := -1
                shBi := -1
                shCi := -1
                sh := Eng.new(dir = -d, off = i, anchor = i, hiIdx = i)
                sh.feed(i)
                shA3 := false
                shA4 := false
            if eng.evMss and mssFlip
                // MSS: two closes beyond the MSS line, three levels
                followMain := false
                nextC := false
                if eng.bosCnt > 0
                    int cI = eng.lvlHiBos
                    if eng.z1Ok
                        cI := math.min(cI, eng.z1Left)
                    if eng.z2Ok
                        cI := math.min(cI, eng.z2Left)
                    shiftCutT := array.get(T, cI)
                vis.seal()
                eng.topZone(i)
                if eng.tzOk
                    oldTzIdx := eng.tzIdx
                    oldTzTop := d * eng.tzTop   // the highest point reached before the retracement
                    float tzBody = math.abs(eng.nC(eng.tzIdx) - eng.nO(eng.tzIdx))
                    bool tzDoji = (eng.nH(eng.tzIdx) - eng.nL(eng.tzIdx) - tzBody) > tzBody
                    oldTzBot := d * (tzDoji ? eng.nL(eng.tzIdx) : eng.nC(eng.tzIdx))   // close up to the high (doji: whole candle)
                else
                    oldTzIdx := -1
                if showZone
                    // the old Level 2 / Level 1 zones become SBR / KML (RBS / QML): bring them back and extend them to the right
                    if not na(z2Box)
                        f_grow(z2Box, time)
                        box.set_border_color(z2Box, color.new(d == 1 ? cSBR : cRBS, 40))
                        box.set_border_style(z2Box, line.style_solid)
                        box.set_border_width(z2Box, 1)
                        box.set_text_color(z2Box, cZTxt)
                        box.set_bgcolor(z2Box, color.new(d == 1 ? cSBR : cRBS, shFill))
                        box.set_text(z2Box, d == 1 ? "SBR" : "RBS")
                        array.push(lvBoxes, z2Box)
                    if not na(z1Box)
                        f_grow(z1Box, time)
                        box.set_border_color(z1Box, color.new(cQML, 40))
                        box.set_border_width(z1Box, 1)
                        box.set_border_style(z1Box, line.style_solid)
                        box.set_text_color(z1Box, cZTxt)
                        box.set_bgcolor(z1Box, color.new(cQML, shFill))
                        box.set_text(z1Box, "QML")
                        array.push(lvBoxes, z1Box)
                    if eng.tzOk
                        array.push(lvBoxes, f_zbox(array.get(T, eng.tzIdx), d * eng.tzTop, d * eng.tzBot, d == 1 ? cDT : cDB, d == 1 ? "L3 double top" : "L3 double bottom", false, shFill, 1))
                f_endline(mssLn, array.get(T, eng.mssFirst))
                mssLn := na
                z1Box := na
                z2Box := na
                z1Act := false
                z2Act := false
                // the shift is only undone when price takes back the extreme of the old structure (the double top / bottom),
                // not merely the MSS line, which usually lies inside the SBR / RBS zone
                float ext = eng.nH(eng.bosIdx)
                for k = eng.bosIdx to i
                    ext := math.max(ext, eng.nH(k))
                oldLine := d * ext
                oldDir := d
                oldCnt := 0
                oldFirst := eng.mssFirst
                oldOn := true
                label.new(array.get(T, eng.mssFirst), d == 1 ? array.get(L, eng.mssFirst) : array.get(H, eng.mssFirst), "MSS", xloc = xloc.bar_time, style = d == 1 ? label.style_label_up : label.style_label_down, color = cMss, textcolor = cMssTxt, size = szMss)
                int fr = eng.mssFirst
                Eng ne = Eng.new(dir = -d, off = fr, anchor = fr, hiIdx = fr)
                for k = fr to i
                    ne.feed(k)
                eng := ne
                trend := ne.dir
                ntOn := true
                ntSeen := true
                ntBos := ne.bosCnt > 0
                ntRet := ne.bosCnt > 0 and ne.phase == 1
                ntBody := na
                if ntRet
                    int pk3 = ne.levelHi
                    ntBody := math.max(ne.nO(pk3), ne.nC(pk3))
                // BOS events inside the replayed bars were not drawn live: draw the latest one now
                if ne.bosCnt > 0
                    drawE := ne
                    doDraw := true
                shHiIdx := -1
                shifted := true
            else if eng.evMss
                // a single anti-directional wave: no trend shift, stop watching this MSS line
                f_endline(mssLn, time)
                eng.mssLine := na
            else if eng.evBos
                drawE := eng
                doDraw := true

            bool dmMade = false
            // levels from the old structure and the old MSS line, until a new 1-2 forms
            if oldOn and not shifted
                if eng.evBos
                    oldOn := false
                    for b in lvBoxes
                        f_endbox(b, time)
                    array.clear(lvBoxes)
                else
                    if eng.evP2
                        for b in lvBoxes
                            f_endbox(b, time)
                        array.clear(lvBoxes)
                    bool beyond = eng.dir == -1 ? close > oldLine : close < oldLine
                    if beyond
                        if oldCnt == 0
                            oldFirst := i
                        oldCnt += 1
                        if oldCnt >= mssN
                            int fb = oldFirst
                            vis.seal()
                            // double MSS: far zone from the engine that is being left (still `eng` here)
                            DmZ dz = (showDM and showZone) ? eng.dmF(eng.phase == 1 ? eng.sIdx : eng.pendOn ? eng.pS : eng.hiIdx, true) : DmZ.new()
                            Eng nb = Eng.new(dir = oldDir, off = fb, anchor = fb, hiIdx = fb)
                            for k = fb to i
                                nb.feed(k)
                            eng := nb
                            trend := nb.dir
                            ntOn := true
                            ntSeen := true
                            ntBos := nb.bosCnt > 0
                            ntRet := nb.bosCnt > 0 and nb.phase == 1
                            ntBody := na
                            if ntRet
                                int pk4 = nb.levelHi
                                ntBody := math.max(nb.nO(pk4), nb.nC(pk4))
                            if nb.bosCnt > 0
                                drawE := nb
                                doDraw := true
                            shHiIdx := -1
                            oldOn := false
                            for b in lvBoxes
                                f_endbox(b, time)
                                if dz.ok and nb.bosCnt == 0 and oldTzIdx >= 0
                                    // the three old levels (SBR, QML, L3) are faded so the two double-MSS zones stand out
                                    box.set_bgcolor(b, color.new(color.gray, 93))
                                    box.set_border_color(b, color.new(color.gray, 78))
                                    box.set_border_style(b, line.style_dotted)
                                    box.set_text_color(b, color.new(color.gray, 55))
                            array.clear(lvBoxes)
                            label.new(array.get(T, fb), trend == 1 ? array.get(L, fb) : array.get(H, fb), "MSS: trend back", xloc = xloc.bar_time, style = trend == 1 ? label.style_label_up : label.style_label_down, color = cMss, textcolor = cMssTxt, size = szMss)
                            if dz.ok and nb.bosCnt == 0 and oldTzIdx >= 0
                                float dn1 = oldDir * oldTzBot
                                float dn2 = oldDir * oldTzTop
                                f_endbox(dmNBox, time)
                                f_endbox(dmFBox, time)
                                dmOn := true
                                dmMade := true
                                dmK := 2
                                dmOd := oldDir
                                dmDir := oldDir
                                dmCnt := 0
                                dmNFrz := true
                                dmNAct := true
                                dmNEdge := math.min(dn1, dn2)
                                dmPeak := math.max(dn1, dn2)
                                dmFo := dz.fo
                                dmFc := dz.fc
                                dmFf := dz.ff
                                dmFi := dz.ix
                                dmNBox := f_zbox(array.get(T, oldTzIdx), oldTzBot, oldTzTop, cDM, oldDir == 1 ? "MSS2 double top" : "MSS2 double bottom", false, shFill, 1)
                                dmFBox := f_zbox(array.get(T, dz.ix), dz.fo, dz.ff, cDM, oldDir == 1 ? "MSS2 SBR" : "MSS2 RBS", false, shFill, 1)
                                dmBoxEnd := false
                                box.set_extend(dmNBox, extend.none)
                                box.set_extend(dmFBox, extend.none)
                    else
                        oldCnt := 0

            // v4.36 double / triple MSS zones: manage them, flip again after mssN closes beyond the far edge of the far zone
            if dmOn and not dmMade and not shifted
                int dmN = dmDir
                if eng.evBos
                    dmOn := false
                    f_endbox(dmNBox, time)
                    f_endbox(dmFBox, time)
                else
                    if not dmNFrz
                        dmPeak := math.max(dmPeak, eng.nH(i))
                        if eng.phase == 1
                            dmNFrz := true
                        if not na(dmNBox)
                            box.set_top(dmNBox, math.max(dmN * dmNEdge, dmN * dmPeak))
                            box.set_bottom(dmNBox, math.min(dmN * dmNEdge, dmN * dmPeak))
                    if dmNAct and not na(dmNBox) and dmN * close < dmNEdge
                        f_endbox(dmNBox, time)
                        box.set_bgcolor(dmNBox, color.new(color.gray, 88))
                        box.set_border_color(dmNBox, color.gray)
                        box.set_border_style(dmNBox, line.style_dotted)
                        box.set_text_color(dmNBox, color.gray)
                        dmNAct := false
                    if eng.evP2 and not dmBoxEnd
                        // same length as the SBR / QML / L3 zones: they end at the new trend's first retracement
                        f_endbox(dmNBox, time)
                        f_endbox(dmFBox, time)
                        dmBoxEnd := true
                    if not dmBoxEnd
                        // open zones reach only to the latest candle, never into the empty space on the right
                        if not na(dmFBox)
                            f_grow(dmFBox, time)
                        if not na(dmNBox) and dmNAct
                            f_grow(dmNBox, time)
                    if dmN * close < dmN * dmFf
                        if dmCnt == 0
                            dmFirst := i
                        dmCnt += 1
                    else
                        dmCnt := 0
                    if dmCnt >= mssN
                        int dm2 = -dmN
                        Eng dmPe = eng
                        int dmPs = dmPe.phase == 1 ? dmPe.sIdx : dmPe.pendOn ? dmPe.pS : dmPe.hiIdx
                        DmZ dz3 = dmPe.dmF(dmPs, dm2 == dmOd)
                        int fb3 = dmFirst
                        float pCl = dmFc
                        float pFar = dmFf
                        int pIx = dmFi
                        f_endbox(dmNBox, time)
                        f_endbox(dmFBox, time)
                        vis.seal()
                        Eng n3 = Eng.new(dir = dm2, off = fb3, anchor = fb3, hiIdx = fb3)
                        for k = fb3 to i
                            n3.feed(k)
                        eng := n3
                        trend := dm2
                        ntOn := true
                        ntSeen := true
                        ntBos := n3.bosCnt > 0
                        ntRet := n3.bosCnt > 0 and n3.phase == 1
                        ntBody := na
                        if ntRet
                            int pk5 = n3.levelHi
                            ntBody := math.max(n3.nO(pk5), n3.nC(pk5))
                        if n3.bosCnt > 0
                            drawE := n3
                            doDraw := true
                        shHiIdx := -1
                        label.new(array.get(T, fb3), dmN == 1 ? array.get(L, fb3) : array.get(H, fb3), "MSS " + str.tostring(dmK + 1), xloc = xloc.bar_time, style = dmN == 1 ? label.style_label_up : label.style_label_down, color = cMss, textcolor = cMssTxt, size = szMss)
                        if dz3.ok and n3.bosCnt == 0
                            dmK += 1
                            dmDir := dm2
                            dmCnt := 0
                            dmNFrz := true
                            dmNAct := true
                            dmNEdge := dm2 * pCl
                            dmPeak := dm2 * pFar
                            dmFo := dz3.fo
                            dmFc := dz3.fc
                            dmFf := dz3.ff
                            dmFi := dz3.ix
                            dmNBox := f_zbox(array.get(T, pIx), dm2 * dmNEdge, dm2 * dmPeak, cDM, "MSS" + str.tostring(dmK) + (dm2 == 1 ? " upper" : " lower"), false, shFill, 1)
                            dmFBox := f_zbox(array.get(T, dz3.ix), dz3.fo, dz3.ff, cDM, "MSS" + str.tostring(dmK) + (dm2 == 1 ? " lower" : " upper"), false, shFill, 1)
                            dmBoxEnd := false
                            box.set_extend(dmNBox, extend.none)
                            box.set_extend(dmFBox, extend.none)
                            shiftCutT := array.get(T, math.min(pIx, dz3.ix))
                        else
                            dmOn := false

    // Deferred check (one candle after a BOS): gaps whose MIDDLE candle is the BOS candle. Candle 3 only exists now.
    if pfB >= 1 and i == pfB + 1
        int pm = pfB
        bool pfMidBull = pfDir * array.get(C, pm) > pfDir * array.get(O, pm)
        float pfH1 = pfDir == 1 ? array.get(H, pm - 1) : -array.get(L, pm - 1)
        float pfL1 = pfDir == 1 ? array.get(L, pm - 1) : -array.get(H, pm - 1)
        float pfL3 = pfDir == 1 ? array.get(L, pm + 1) : -array.get(H, pm + 1)
        if pfMidBull and pfL3 > pfH1
            float pfR1 = pfDir * pfH1
            float pfR2 = pfDir * pfL3
            string pfTip = "gap: " + str.tostring(math.min(pfR1, pfR2), format.mintick) + " - " + str.tostring(math.max(pfR1, pfR2), format.mintick)
            if pf3 and pfL3 >= pfBot and pfH1 <= pfTop
                if not na(pfBox)
                    box.set_text(pfBox, "L1 / " + (pfSbt5 ? "SBT5+" : "") + "SBT3")
            if pf4 and (pm - 1) >= pf2Left and pfL1 <= pf2Top and pfH1 >= pf2Bot
                if not na(pf2Box)
                    box.set_text(pf2Box, "L2 / SBT 4")
        pfB := -1
        pf3 := false
        pf4 := false
        pfBox := na
        pf2Box := na

    // ───────── draw a structure (BOS, or a promoted five-wave structure)
    if doDraw and not na(drawE) and not (ntOn and hideNt)
        Eng e = drawE
        int dd = e.dir
        f_endline(mssLn, time)
        f_endbox(z1Box, time)
        f_endbox(z2Box, time)
        bool md0 = markDir
        if forceDraw
            markDir := false   // the shift itself is not marked with 1 / BOS / 2 of the old A-B; C, then 1 and 2, follow as price breaks C
        fmark := false
        vis.finish(e)
        markDir := md0
        fmark := false
        if showMssL
            mssLn := line.new(array.get(T, e.mssIdx), dd * e.mssLine, math.max(time, array.get(T, e.mssIdx) + 1), dd * e.mssLine, xloc = xloc.bar_time, color = cMssLn, style = line.style_dotted, width = 1, extend = extend.right)
        z1Box := na
        z2Box := na
        z1Act := false
        z2Act := false
        if showZone
            if e.z1Ok
                string z1Tags = ""
                if e.z1Sbt5
                    z1Tags := z1Tags + "SBT5"
                else if e.z1Sbt2 and not e.z1Sbt3
                    z1Tags := z1Tags + "SBT-2"
                if e.z1Sbt3
                    z1Tags := z1Tags + (z1Tags == "" ? "" : "+") + "SBT3"
                string z1Txt = z1Tags == "" ? "L1" : "L1 / " + z1Tags + ((e.z1Sbt3 or e.z1Sbt5) ? "" : (dd == 1 ? " D" : " S"))
                z1Box := f_zbox(array.get(T, e.z1Left), dd * e.z1Top, dd * e.z1Bot, cL1, z1Txt, false, useAll ? shFill : 82)
                z1Act := true
            if e.z2Ok
                string z2Txt = "L2"
                if e.z2Sbt4
                    z2Txt := "L2 / SBT 4"
                else if not e.z2Mit
                    z2Txt := dd == 1 ? "L2 / SBT-1 D" : "L2 / SBT-1 S"
                z2Box := f_zbox(array.get(T, e.z2Left), dd * e.z2Top, dd * e.z2Bot, cL2, z2Txt, true, useAll ? shFill : 82)
                z2Act := true
                if e.z2Sbt4 and e.z2Sbt4Idx >= 0
                    float s4A = dd * e.z2GapLo
                    float s4B = dd * e.z2GapHi
                    int s4I = e.z2Sbt4Idx
        // arm the one-candle-later check for gaps whose middle candle is the BOS candle
        pfB := -1
        pf3 := false
        pf4 := false
        if showZone and e.anchor == i
            pfB := i
            pfDir := dd
            pf3 := e.z1Ok and not e.z1Sbt3
            pf4 := e.z2Ok and not e.z2Sbt4
            pfTop := e.z1Top
            pfBot := e.z1Bot
            pfSbt2 := e.z1Sbt2
            pfSbt5 := e.z1Sbt5
            pfBox := z1Box
            pf2Top := e.z2Top
            pf2Bot := e.z2Bot
            pf2Left := e.z2Left
            pf2Box := z2Box

    if nextC and trend != 0 and not na(eng) and eng.evBos and i > shFifthBar
        nextC := false

    if relabel and i > shFifthBar
        if not na(lblC)
            label.set_text(lblC, "1")
            label.set_color(lblC, c1)
            label.set_size(lblC, s1)
        if not na(lblD)
            label.set_text(lblD, "2")
            label.set_color(lblD, c2)
            label.set_size(lblD, s2)
        relabel := false

    // ───────── keep the pending 1 / 2 / BS line in sync with the main engine
    if trend != 0 and not na(eng) and markDir and not (ntOn and hideNt)
        if vis.on
            vis.track(eng)
        else if eng.phase == 1
            vis.showPending(eng)

    // ───────── deactivation: a close beyond a zone switches it off
    if trend != 0
        if z1Act and not na(z1Box) and eng.nC(i) < eng.z1Bot
            f_endbox(z1Box, time)
            box.set_bgcolor(z1Box, color.new(color.gray, 88))
            box.set_border_color(z1Box, color.gray)
            box.set_border_style(z1Box, line.style_dotted)
            box.set_text_color(z1Box, color.gray)
            z1Act := false
        if z2Act and not na(z2Box) and eng.nC(i) < eng.z2Bot
            f_endbox(z2Box, time)
            box.set_bgcolor(z2Box, color.new(color.gray, 88))
            box.set_border_color(z2Box, color.gray)
            box.set_border_style(z2Box, line.style_dotted)
            box.set_text_color(z2Box, color.gray)
            z2Act := false
        // every zone that is still open reaches only to the latest candle
        if z1Act and not na(z1Box)
            f_grow(z1Box, time)
        if z2Act and not na(z2Box)
            f_grow(z2Box, time)
        for b in lvBoxes
            f_grow(b, time)

// ───────────────────────────── "Latest" view: remove everything that belongs to an older structure
// Cut-off = start of the current structure: its point 1 (or the first candle of its zones, whichever is earlier). While no BOS has
// happened yet in the new trend, it is the candle where the shift started. Active SBR / QML / Level 3 levels are always kept.
if barstate.islast and viewMode == "Latest" and trend != 0 and not na(eng)
    int cutT = na
    // right after a trend shift keep the structure that was shifted (its zones, SBR / QML / L3, MSS) together with the new trend
    bool keepShift = not na(shiftCutT) and (ntOn or oldOn or eng.bosCnt == 0)
    if keepShift
        cutT := shiftCutT
    else if eng.bosCnt > 0
        int c = eng.lvlHiBos
        if eng.z1Ok
            c := math.min(c, eng.z1Left)
        if eng.z2Ok
            c := math.min(c, eng.z2Left)
        cutT := array.get(T, c)
    else
        cutT := array.get(T, eng.off)
    if oldOn
        for b in lvBoxes
            int lf = box.get_left(b)
            if not na(lf)
                cutT := math.min(cutT, lf)
    for l in label.all
        if label.get_x(l) < cutT
            label.delete(l)
    for ln in line.all
        if line.get_x1(ln) < cutT
            line.delete(ln)
    for bx in box.all
        if box.get_left(bx) < cutT
            box.delete(bx)

// ───────────────────────────── Status table
var table tbl = table.new(position.top_right, 2, 9, bgcolor = color.new(#0F172A, 10), border_width = 1, border_color = color.new(#64748B, 40))
if barstate.islast and showTbl
    string trendTxt = trend == 1 ? "Bullish" : trend == -1 ? "Bearish" : "Undecided"
    string mssTxt = "-"
    string aTxt = "-"
    string bTxt = "-"
    string cTxtT = "-"
    string dTxt = "-"
    string sTxt = "-"
    if trend != 0 and not na(eng)
        // the MSS happens on a close beyond this price (two closes, see settings)
        if not na(eng.mssLine)
            mssTxt := (eng.dir == 1 ? "below " : "above ") + str.tostring(eng.dir * eng.mssLine, format.mintick)
        if shFifth
            aTxt := "placed" + (na(shApx) ? "" : " at " + str.tostring(shApx, format.mintick))
            bTxt := "formed" + ((na(shBpxY) or na(shBpxT)) ? "" : ": zone " + str.tostring(math.min(shBpxY, shBpxT), format.mintick) + " - " + str.tostring(math.max(shBpxY, shBpxT), format.mintick))
            cTxtT := "placed" + (na(shCpx) ? "" : " at " + str.tostring(shCpx, format.mintick))
            dTxt := "placed"
            sTxt := "trend shifted | A-B-C-D marked, C = 1, C-D = 2"
        else if not na(sh)
            string bk = sh.dir == -1 ? "below " : "above "
            int shSt = shStart < 0 ? -1 : shA4 ? 3 : shA3 ? 2 : sh.phase == 1 ? 1 : 0
            int stg = math.max(shSt, mzStage)
            if shSt < 0
                aTxt := (ntOn or oldOn or dmOn) ? "levels being tested (no minor structure yet)" : "waiting for a retracement of the trend"
            else if stg == 0
                aTxt := (ntOn or oldOn or dmOn) ? "levels being tested, A not placed yet" : "retracement started, A not placed yet"
            else
                float aP = shSt >= 2 ? sh.dir * sh.lvlBos : shSt == 1 ? sh.dir * sh.level : sh.dir * mzBrk
                aTxt := "placed at " + str.tostring(aP, format.mintick)
                if stg == 1
                    bTxt := "waiting | body close " + bk + str.tostring(aP, format.mintick)
                else
                    bTxt := "formed: Level 2 zone (a body closed beyond A)"
                if stg == 2
                    cTxtT := "waiting for the pullback after B"
                if stg == 3
                    float cP = shSt == 3 ? sh.dir * sh.level : na
                    cTxtT := "placed" + (na(cP) ? "" : " at " + str.tostring(cP, format.mintick))
                    float dP = shSt == 3 ? sh.dir * sh.p2Low : na
                    dTxt := "pullback after C" + (na(dP) ? "" : " at " + str.tostring(dP, format.mintick))
                    float shf = shSt == 3 ? sh.dir * shA3c : sh.dir * mzShf
                    sTxt := "body close " + bk + str.tostring(shf, format.mintick) + " shifts the trend"
    table.cell(tbl, 0, 0, "Trend", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 0, trendTxt, text_color = trend == 1 ? #22C55E : trend == -1 ? color.red : color.gray, text_size = size.small)
    table.cell(tbl, 0, 1, "MSS line", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 1, mssTxt, text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 2, "A", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 2, aTxt, text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 3, "B", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 3, bTxt, text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 4, "C", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 4, cTxtT, text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 5, "D", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 5, dTxt, text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 6, "Trend shift", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 6, sTxt, text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 7, "Marking", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 7, viewMode, text_color = viewMode == "Latest" ? #F59E0B : color.white, text_size = size.small)
    table.cell(tbl, 0, 8, "Double MSS", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 8, dmOn ? "MSS" + str.tostring(dmK) + " zones | flips on " + str.tostring(mssN) + " closes " + (dmDir == 1 ? "below " : "above ") + str.tostring(dmFf, format.mintick) : "-", text_color = dmOn ? #FCD34D : color.white, text_size = size.small)
