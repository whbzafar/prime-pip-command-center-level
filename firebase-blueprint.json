      },
      "required": ["id", "name", "providerCode", "baseUrl", "authType", "status", "createdAt", "updatedAt"]
    },
    "Observation": {
      "title": "Observation",
      "description": "Official economic indicator observation record. Missing values strictly preserved as null.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Observation ID" },
        "indicatorId": { "type": "string", "description": "Referenced indicator ID" },
        "assetId": { "type": "string", "description": "Referenced asset ID" },
        "currency": { "type": "string", "description": "Currency code" },
        "country": { "type": "string", "description": "Country code" },
        "period": { "type": "string", "description": "Reporting period (e.g. 2026-09)" },
        "periodType": { "type": "string", "enum": ["MONTHLY", "WEEKLY", "DAILY", "QUARTERLY", "ANNUAL"] },
        "releaseDate": { "type": "string", "description": "Official release date" },
        "value": { "type": "number", "description": "Realized observation value or null" },
        "unit": { "type": "string", "description": "Measurement unit" },
        "previousValue": { "type": "number", "description": "Preceding period value" },
        "forecastValue": { "type": "number", "description": "Consensus forecast or null" },
        "actualValue": { "type": "number", "description": "Published actual or null" },
        "revisionValue": { "type": "number", "description": "Revised value or null" },
        "isRevision": { "type": "boolean", "description": "Whether observation is a revision" },
        "sourceId": { "type": "string", "description": "Originating source ID" },
        "providerId": { "type": "string", "description": "Retrieval provider ID" },
        "sourceUrl": { "type": "string", "description": "Official release URL" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "validationStatus": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "PENDING_VALIDATION",
            "DATA_UNAVAILABLE",
            "SOURCE_ERROR",
            "VALIDATION_ERROR",
            "NEEDS_REVIEW",
            "SUPERSEDED"
          ]
        },
        "validationReason": { "type": "string" },
        "dataQuality": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
        "confidence": { "type": "number", "description": "0-100 verification confidence score" },
        "freshness": { "type": "string", "enum": ["LIVE", "RECENT", "HISTORICAL", "STALE", "UNAVAILABLE"] },
        "isSyntheticTest": { "type": "boolean", "description": "Must not be true in production" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "indicatorId", "currency", "country", "period", "unit", "isRevision", "sourceId", "providerId", "retrievedAt", "validationStatus", "dataQuality", "confidence", "createdAt", "updatedAt"]
    },
