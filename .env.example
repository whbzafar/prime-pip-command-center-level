# PrimePipFx Command Center — production environment

# Gemini / AI
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ----------------------------------------------------
# LIVE ECONOMIC CALENDAR
# ----------------------------------------------------
# Preferred provider for the current implementation.
# The app NEVER fabricates Actual / Forecast / Previous values.
FMP_API_KEY=

# Optional compatible JSON calendar endpoint. If set, it is used instead of FMP.
# It must return an array, {"events": [...]}, or {"items": [...]}
# and must provide real event date/time plus Actual/Forecast/Previous when available.
ECONOMIC_NEWS_RADAR_URL=

# ----------------------------------------------------
# USER DATA / REALTIME COMMUNITY BACKEND
# ----------------------------------------------------
# Supabase is the recommended persistent backend for Vercel deployments.
# Use the Project URL plus the NEW secret key on the server only.
# NEVER expose SUPABASE_SECRET_KEY in VITE_ variables or browser code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Browser publishable key (only required after the app's Supabase Auth client is enabled).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ----------------------------------------------------
# GOOGLE DRIVE USER BACKUP
# ----------------------------------------------------
# Google OAuth client ID. The app will report an OAuth error rather than creating a fake token.
VITE_GOOGLE_CLIENT_ID=

# Optional legacy MYFXBOOK integration
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=
